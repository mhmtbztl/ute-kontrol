{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexbnb.local/schemas/photo-analysis-v1.json",
  "title": "LexBnB Photo Analysis Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "propertyId",
    "overallGalleryScore",
    "confidence",
    "coverAnalysis",
    "photoEvaluations",
    "missingCoverage",
    "recommendedStoryOrder",
    "trustAssessment"
  ],
  "properties": {
    "schemaVersion": { "const": "photo-analysis-v1" },
    "runId": { "type": "string", "minLength": 1 },
    "propertyId": { "type": "string", "minLength": 1 },
    "overallGalleryScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentCoverMediaId", "currentCoverScore", "bestCoverCandidates"],
      "properties": {
        "currentCoverMediaId": { "type": "string", "minLength": 1 },
        "currentCoverScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "bestCoverCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mediaId", "score", "uspMatch", "reason"],
            "properties": {
              "mediaId": { "type": "string", "minLength": 1 },
              "score": { "type": "number", "minimum": 0, "maximum": 100 },
              "uspMatch": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "photoEvaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId",
          "roomCategory",
          "technicalScore",
          "commercialScore",
          "improvementType",
          "issuesDetected",
          "actionableRecommendations",
          "editOperations",
          "observedFeatures"
        ],
        "properties": {
          "mediaId": { "type": "string", "minLength": 1 },
          "roomCategory": {
            "enum": [
              "EXTERIOR", "LIVING_ROOM", "BEDROOM", "BATHROOM", "KITCHEN",
              "DINING", "POOL", "SPA", "VIEW_TERRACE", "AMENITY", "OTHER"
            ]
          },
          "technicalScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "commercialScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "improvementType": { "enum": ["NONE", "EDITABLE", "RESHOOT"] },
          "issuesDetected": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "actionableRecommendations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "editOperations": {
            "type": "array",
            "items": {
              "enum": [
                "EXPOSURE", "WHITE_BALANCE", "STRAIGHTEN", "CROP",
                "PERSPECTIVE_CORRECTION", "MINOR_CLUTTER_REMOVAL",
                "NOISE_REDUCTION", "SHARPEN"
              ]
            }
          },
          "observedFeatures": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "missingCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coverageKey", "explanation", "confidence"],
        "properties": {
          "coverageKey": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "recommendedStoryOrder": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suggestedIndex", "mediaId", "roleInStory"],
        "properties": {
          "suggestedIndex": { "type": "integer", "minimum": 1 },
          "mediaId": { "type": "string", "minLength": 1 },
          "roleInStory": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trustAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fabricationSuggested", "uncertainClaims"],
      "properties": {
        "fabricationSuggested": { "const": false },
        "uncertainClaims": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
